<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="92dp" android:height="36dp" android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#6F797F" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:width="92dp" android:height="36dp">
        <shape android:shape="rectangle">
            <gradient android:angle="180" android:endColor="#ffd435" android:startColor="#ffa708" android:type="linear" android:useLevel="true" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>