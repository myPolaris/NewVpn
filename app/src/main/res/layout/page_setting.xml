<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@mipmap/bj"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.setting.SettingActivity">

    <include
        android:id="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_toolbar"/>
    
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_check_up"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardBackgroundColor="#80364046"
        android:layout_marginTop="16dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:cardCornerRadius="32dp"
        app:strokeWidth="1dp"
        app:strokeColor="#52FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/toolbar"/>
    
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_check_up"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:src="@mipmap/check"
        app:layout_constraintTop_toTopOf="@id/card_check_up"
        app:layout_constraintBottom_toBottomOf="@id/card_check_up"
        app:layout_constraintLeft_toLeftOf="@id/card_check_up"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_check_up"
        android:text="Check For Update"
        android:textColor="@color/white"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintRight_toLeftOf="@id/img_more_check_up"
        app:layout_constraintTop_toTopOf="@id/card_check_up"
        app:layout_constraintBottom_toBottomOf="@id/card_check_up"
        app:layout_constraintLeft_toRightOf="@id/img_check_up"
        android:layout_marginStart="10dp"
        android:textSize="16sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_more_check_up"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@mipmap/more"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/card_check_up"
        app:layout_constraintBottom_toBottomOf="@id/card_check_up"
        app:layout_constraintLeft_toRightOf="@id/tv_check_up"
        app:layout_constraintRight_toRightOf="@id/card_check_up"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_share"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardBackgroundColor="#80364046"
        android:layout_marginTop="12dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:cardCornerRadius="32dp"
        app:strokeWidth="1dp"
        app:strokeColor="#52FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/card_check_up"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_share"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:src="@mipmap/share"
        app:layout_constraintTop_toTopOf="@id/card_share"
        app:layout_constraintBottom_toBottomOf="@id/card_share"
        app:layout_constraintLeft_toLeftOf="@id/card_share"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_share"
        android:text="Share us"
        android:textColor="@color/white"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintRight_toLeftOf="@id/img_more_share"
        app:layout_constraintTop_toTopOf="@id/card_share"
        app:layout_constraintBottom_toBottomOf="@id/card_share"
        app:layout_constraintLeft_toRightOf="@id/img_share"
        android:layout_marginStart="10dp"
        android:textSize="16sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_more_share"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@mipmap/more"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/card_share"
        app:layout_constraintBottom_toBottomOf="@id/card_share"
        app:layout_constraintLeft_toRightOf="@id/tv_share"
        app:layout_constraintRight_toRightOf="@id/card_share"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_privacy_policy"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardBackgroundColor="#80364046"
        android:layout_marginTop="12dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:cardCornerRadius="32dp"
        app:strokeWidth="1dp"
        app:strokeColor="#52FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/card_share"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_privacy_policy"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:src="@mipmap/privacy_policy"
        app:layout_constraintTop_toTopOf="@id/card_privacy_policy"
        app:layout_constraintBottom_toBottomOf="@id/card_privacy_policy"
        app:layout_constraintLeft_toLeftOf="@id/card_privacy_policy"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_privacy_policy"
        android:text="Privacy Policy"
        android:textColor="@color/white"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintRight_toLeftOf="@id/img_more_privacy_policy"
        app:layout_constraintTop_toTopOf="@id/card_privacy_policy"
        app:layout_constraintBottom_toBottomOf="@id/card_privacy_policy"
        app:layout_constraintLeft_toRightOf="@id/img_privacy_policy"
        android:layout_marginStart="10dp"
        android:textSize="16sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_more_privacy_policy"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@mipmap/more"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/card_privacy_policy"
        app:layout_constraintBottom_toBottomOf="@id/card_privacy_policy"
        app:layout_constraintLeft_toRightOf="@id/tv_privacy_policy"
        app:layout_constraintRight_toRightOf="@id/card_privacy_policy"
        />


</androidx.constraintlayout.widget.ConstraintLayout>